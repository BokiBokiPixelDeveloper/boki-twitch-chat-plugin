{
  "version": 8,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "linux-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "ENABLE_QT": true,
        "ENABLE_FRONTEND_API": false
      }
    },
    {
      "name": "linux-x86_64",
      "displayName": "Linux x86_64",
      "description": "Local Linux development build",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "linux-ci-x86_64",
      "displayName": "Linux x86_64 CI",
      "description": "CI build with warnings as errors",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "windows-x86_64",
      "displayName": "Windows x86_64 (MSVC)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/windows-x86_64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "${sourceDir}/.deps/windows/obs;${sourceDir}/.deps/windows/qt;${sourceDir}/.deps/windows/webp",
        "ENABLE_TESTS": true
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-x86_64",
      "configurePreset": "linux-x86_64",
      "jobs": 0
    },
    {
      "name": "linux-ci-x86_64",
      "configurePreset": "linux-ci-x86_64",
      "jobs": 0
    },
    {
      "name": "windows-x86_64",
      "configurePreset": "windows-x86_64",
      "configuration": "RelWithDebInfo"
    }
  ]
}
